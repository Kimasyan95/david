---
import { useTranslations, translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const skills: string[] = [...translations[lang].about.skillsList];

const expertise = [
  {
    title: lang === 'ru' ? 'Монтаж' : lang === 'en' ? 'Editing' : lang === 'ka' ? 'მონტაჟი' : 'Մոնտաժ',
    desc: t('about.p1'),
  },
  {
    title: lang === 'ru' ? 'Субтитры' : lang === 'en' ? 'Subtitles' : lang === 'ka' ? 'სუბტიტრები' : 'Ենթագրեր',
    desc: t('about.p2'),
  },
  {
    title: 'YouTube',
    desc: lang === 'ru' ? 'Работаю с YouTube-каналами, создаю видео которые держат зрителя до конца.' : lang === 'en' ? 'Working with YouTube channels, creating videos that keep viewers until the end.' : lang === 'ka' ? 'ვმუშაობ YouTube-ის არხებთან.' : 'Աշխատում եմ YouTube ուղիների հետ։',
  },
  {
    title: 'TikTok',
    desc: lang === 'ru' ? 'Создаю короткий контент для TikTok с цепляющим началом и динамичным темпом.' : lang === 'en' ? 'Creating short-form TikTok content with hooky openings and dynamic pacing.' : lang === 'ka' ? 'ვქმნი მოკლე კონტენტს TikTok-ისთვის.' : 'Ստեղծում եմ կարճ կոնտենտ TikTok-ի համար։',
  },
];
---

<section id="about" class="py-24 md:py-36 px-6">
  <div class="max-w-[1216px] mx-auto">

    <!-- Section heading -->
    <div class="flex items-end justify-between mb-16 pb-10">
      <h2 class="text-5xl md:text-6xl font-semibold text-[var(--text)] leading-tight max-w-lg">
        {t('about.subtitle')}
      </h2>
      <a
        href="https://t.me/davovideo"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:flex items-center gap-2 text-[var(--text)] opacity-50 hover:opacity-100 transition-opacity font-medium text-lg"
      >
        Telegram
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>

    <!-- Expertise grid: 4 columns like Joey -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {expertise.map((item) => (
        <div class="flex flex-col gap-4">
          <h3 class="text-2xl md:text-3xl font-semibold text-[var(--text)]">{item.title}</h3>
          <p class="text-[var(--text)] opacity-50 text-base leading-relaxed font-medium">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Skills tags -->
    <div class="flex flex-wrap gap-3">
      {skills.map((skill: string) => (
        <span class="border border-[var(--border)] text-[var(--text)] text-sm font-medium px-5 py-2.5 rounded-full opacity-70 hover:opacity-100 transition-opacity">
          {skill}
        </span>
      ))}
    </div>

  </div>
</section>
