---
import { useTranslations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-24 md:py-36 px-6">
  <div class="max-w-[1216px] mx-auto">

    <!-- Testimonial-style quote block (like Joey) -->
    <div class="pb-16 mb-16">
      <p class="text-3xl md:text-5xl font-semibold text-[var(--text)] leading-snug max-w-4xl">
        {lang === 'ru'
          ? 'Ваша идея — мой монтаж. Давайте вместе создавать видео, которые привлекают внимание и помогают развивать ваш проект.'
          : lang === 'en'
          ? 'Your idea — my edit. Let\'s create videos together that capture attention and help grow your project.'
          : lang === 'ka'
          ? 'თქვენი იდეა — ჩემი მონტაჟი. ერთად შევქმნათ ვიდეოები, რომლებიც ყურადღებას იპყრობს.'
          : 'Ձեր գաղափարը — իմ մոնտաժը։ Միասին ստեղծենք տեսանյութեր, որոնք գրավում են ուշադրությունը։'}
      </p>
    </div>

    <!-- Let's Talk block -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-10">

      <div>
        <p class="text-[var(--text)] opacity-50 font-medium text-lg mb-2">{t('contact.subtitle')}</p>
        <p class="text-[var(--text)] opacity-30 font-medium text-base mb-4">
          {lang === 'ru'
            ? 'Открыт к сотрудничеству с блогерами, YouTube-каналами и бизнесом'
            : lang === 'en'
            ? 'Open to work with bloggers, YouTube channels and businesses'
            : lang === 'ka'
            ? 'მზად ვარ ბლოგერებთან, YouTube-არხებთან და ბიზნესებთან თანამშრომლობისთვის'
            : 'Բաց եմ բլոգերների, YouTube-ալիքների և բիզնեսի հետ համագործակցության համար'}
        </p>
        <a
          href="https://t.me/davovideo"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[var(--bg-card)] text-[var(--text)] font-semibold px-8 py-5 rounded-full text-lg hover:opacity-70 transition-opacity mt-4"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.833.941z"/>
          </svg>
          {t('contact.telegram')}
        </a>
      </div>

      <!-- Social links -->
      <div class="flex items-center gap-8">
        <a href="https://www.youtube.com" target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2 text-[var(--text)] opacity-40 hover:opacity-100 transition-opacity font-semibold text-lg">
          YouTube
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
        <a href="https://www.tiktok.com" target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2 text-[var(--text)] opacity-40 hover:opacity-100 transition-opacity font-semibold text-lg">
          TikTok
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
