---
import { useTranslations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex flex-col justify-center px-6 pt-24 pb-16 overflow-hidden">
  <!-- Background noise/grain effect -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); background-size: 200px;"></div>

  <!-- Glow orbs -->
  <div class="absolute top-1/4 -left-32 w-96 h-96 bg-[#c8f65d]/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-32 w-80 h-80 bg-[#c8f65d]/8 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto w-full">
    <div class="max-w-4xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 mb-8">
        <span class="w-2 h-2 bg-[#c8f65d] rounded-full animate-pulse"></span>
        <span class="text-sm text-white/60 font-medium">Available for work</span>
      </div>

      <!-- Heading -->
      <h1 class="text-6xl md:text-8xl lg:text-[10rem] font-black leading-none tracking-tight mb-6">
        <span class="block text-white/30 text-2xl md:text-3xl font-medium tracking-widest uppercase mb-4">
          {t('hero.greeting')}
        </span>
        <span class="block text-white">{t('hero.name')}</span>
        <span class="block text-[#c8f65d]">{t('hero.role')}</span>
      </h1>

      <!-- Tagline -->
      <p class="text-lg md:text-xl text-white/50 max-w-2xl leading-relaxed mb-12">
        {t('hero.tagline')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={lang === 'ru' ? '/#work' : '/en#work'}
          class="inline-flex items-center gap-3 bg-[#c8f65d] text-black font-bold px-8 py-4 rounded-full text-base hover:bg-[#d4ff6a] transition-all duration-200 hover:scale-105"
        >
          {t('hero.cta')}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
        <a
          href="https://t.me/davovideo"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 border border-white/20 text-white font-semibold px-8 py-4 rounded-full text-base hover:border-white/50 hover:bg-white/5 transition-all duration-200"
        >
          {t('hero.contact')}
        </a>
      </div>

      <!-- Stats -->
      <div class="flex flex-wrap items-center gap-8 mt-16 pt-12 border-t border-white/10">
        <div>
          <div class="text-3xl font-black text-white">50+</div>
          <div class="text-sm text-white/40 mt-1">{lang === 'ru' ? 'Видео смонтировано' : 'Videos edited'}</div>
        </div>
        <div class="w-px h-10 bg-white/10"></div>
        <div>
          <div class="text-3xl font-black text-white">YT & TT</div>
          <div class="text-sm text-white/40 mt-1">{lang === 'ru' ? 'Платформы' : 'Platforms'}</div>
        </div>
        <div class="w-px h-10 bg-white/10"></div>
        <div>
          <div class="text-3xl font-black text-white">4+</div>
          <div class="text-sm text-white/40 mt-1">{lang === 'ru' ? 'Языка контента' : 'Content languages'}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
    <span class="text-xs uppercase tracking-widest">{lang === 'ru' ? 'Скролл' : 'Scroll'}</span>
    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent"></div>
  </div>
</section>
