---
import { useTranslations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex flex-col px-6 overflow-hidden" style="padding-top: 120px;">
  <div class="max-w-[1440px] mx-auto w-full flex flex-col flex-1">

    <!-- Big title + SCROLL DOWN pill on the right aligned to second line -->
    <div class="relative flex-1 flex flex-col justify-center">
      <h1 class="hero-title font-semibold leading-none tracking-tight text-[var(--text)]">
        {t('hero.name')}<br/>
        <span class={lang === 'ru' ? 'hero-role-ru' : lang === 'ka' || lang === 'hy' ? 'hero-role-cyr' : ''}>{t('hero.role')}</span>
      </h1>

      <!-- SCROLL DOWN pill — only for EN and HY -->
      {(lang === 'en' || lang === 'hy') && (
        <a
          href="#work"
          class="scroll-pill hidden md:flex items-center gap-3 bg-[var(--bg-card)] rounded-full px-7 py-5 hover:opacity-70 transition-opacity"
        >
          <span class="text-[var(--text)] font-semibold text-base uppercase tracking-widest whitespace-nowrap">
            Scroll Down
          </span>
          <svg width="13" height="15" fill="none" viewBox="0 0 13 15" class="text-[var(--text)]">
            <path d="M6.5 1v11M1 9l5.5 5.5L12 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      )}
    </div>

    <!-- Bottom row: Let's Talk left | description right -->
    <div class="flex items-start justify-between py-8 border-[var(--border)] mt-auto">
      <div>
        <p class="text-[var(--text)] font-semibold text-lg mb-1">
          {lang === 'ru' ? 'Написать мне' : lang === 'en' ? "Let's Talk" : lang === 'ka' ? 'დამიკავშირდი' : 'Կապ հաստատել'}
        </p>
        <a href="https://t.me/davovideo" target="_blank" rel="noopener noreferrer"
          class="text-[var(--text)] opacity-40 hover:opacity-80 transition-opacity text-sm font-medium">
          t.me/davovideo
        </a>
      </div>

      <p class="text-[var(--text)] opacity-50 text-base font-medium leading-relaxed max-w-sm text-right">
        {t('hero.tagline')}
      </p>
    </div>

  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(72px, 14.5vw, 215px);
    line-height: 1.0;
  }

  .hero-role-ru {
    font-size: clamp(58px, 12.2vw, 178px);
  }

  .hero-role-cyr {
    font-size: clamp(44px, 9vw, 135px);
  }

  /* Position scroll pill: absolute right, vertically on second line of title */
  .scroll-pill {
    position: absolute;
    right: 0;
    bottom: 0;
  }
</style>
